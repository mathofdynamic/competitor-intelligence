{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbd.invalid/schemas/competitor/finding.json",
  "title": "Portable competitor research finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "sourceId", "subject", "findingType", "observedText", "observation", "status", "confidence", "limitations"],
  "properties": {
    "id": {"type": "string", "pattern": "^find_[a-z0-9][a-z0-9_-]{7,120}$"},
    "version": {"type": "integer", "minimum": 1},
    "sourceId": {"type": "string", "pattern": "^src_[a-z0-9][a-z0-9_-]{7,120}$"},
    "subject": {"type": "string", "minLength": 2, "maxLength": 200},
    "findingType": {"enum": ["product", "price", "availability", "policy", "positioning", "service", "unknown"]},
    "observedText": {"type": "string", "minLength": 12, "maxLength": 4000},
    "interpretation": {"type": "string", "maxLength": 2000},
    "normalizedValue": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {
      "value": {"type": ["number", "string"]},
      "currency": {"type": "string", "minLength": 3, "maxLength": 12},
      "unit": {"type": "string", "minLength": 1, "maxLength": 40}
    }},
    "observation": {"type": "object", "additionalProperties": false, "required": ["observedAt", "context"], "properties": {
      "observedAt": {"type": "string", "format": "date-time"},
      "context": {"type": "string", "minLength": 2, "maxLength": 600}
    }},
    "status": {"enum": ["needs_review", "approved", "rejected", "stale", "conflict"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 300}},
    "conflictGroup": {"type": ["string", "null"], "maxLength": 120},
    "review": {"type": ["object", "null"], "additionalProperties": false, "required": ["reviewerId", "decision", "reviewedAt", "note"], "properties": {
      "reviewerId": {"type": "string", "minLength": 2, "maxLength": 120},
      "decision": {"enum": ["approved", "rejected", "stale", "conflict"]},
      "reviewedAt": {"type": "string", "format": "date-time"},
      "note": {"type": "string", "minLength": 3, "maxLength": 1000}
    }}
  }
}
