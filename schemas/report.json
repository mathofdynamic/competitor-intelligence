{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbd.invalid/schemas/competitor/report.json",
  "title": "Portable competitor research report",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "company", "market", "generatedAt", "observationWindow", "status", "findings", "limitations"],
  "properties": {
    "id": {"type": "string", "pattern": "^report_[a-z0-9][a-z0-9_-]{7,120}$"},
    "company": {"type": "string", "minLength": 2, "maxLength": 160},
    "market": {"type": "string", "minLength": 2, "maxLength": 120},
    "generatedAt": {"type": "string", "format": "date-time"},
    "observationWindow": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}}},
    "status": {"enum": ["draft", "review", "approved"]},
    "findings": {"type": "array", "items": {"$ref": "finding.json"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 400}}
  }
}
